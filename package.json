{
  "name": "ci-xr-scan-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "server": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi main.ts",
    "start": "concurrently --raw --names \"infer,vite\" -c \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "gen-icons": "node scripts/generate-icons.mjs",
    "test": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=webkit-iphone15",
    "test:iphone": "playwright test --project=iphone-usb",
    "logs:iphone": "node scripts/iwdp-console.mjs ws://localhost:9222/devtools/page/2"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.1",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  }
}
