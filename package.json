{
  "name": "ci-xr-scan-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "server": "deno run --allow-net --allow-read --allow-env --allow-ffi main.ts",
    "start": "concurrently --raw --names \"infer,vite\" -c \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "gen-icons": "node scripts/generate-icons.mjs",
    "test": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=webkit-iphone15",
    "test:iphone": "playwright test --project=iphone-usb",
    "logs:iphone": "node scripts/iwdp-console.mjs ws://localhost:9222/devtools/page/2"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.173.0",
    "@types/webxr": "^0.5.20",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "ws": "^8.20.0"
  }
}
