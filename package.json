{
  "name": "companion-scan-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "server": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi main.ts",
    "start": "concurrently --raw --names \"infer,vite\" -c \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "gen-icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/copy-draco.mjs",
    "smoke:pipeline": "node scripts/smoke-pipeline.mjs",
    "test:lingbot:glb": "node --experimental-strip-types --no-warnings --test lingbot_map_glb.test.ts",
    "test:lingbot:fetch-video": "node scripts/fetch-lingbot-test-video.mjs",
    "test:lingbot:make-fixture": "node scripts/make-lingbot-fixture.mjs",
    "gen:test-data": "node scripts/generate-test-homes.mjs && node scripts/generate-cv-images.mjs",
    "seed:test-data": "node scripts/seed-test-homes.mjs",
    "eval:cv": "node scripts/eval-cv.mjs",
    "test:api": "playwright test --project=api",
    "test:mock": "playwright test --project=chromium-mock",
    "test": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=webkit-iphone15",
    "test:iphone": "playwright test --project=iphone-usb",
    "logs:iphone": "node scripts/iwdp-console.mjs ws://localhost:9222/devtools/page/2"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@playwright/test": "1.59.0",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.1",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.3",
    "draco3dgltf": "^1.5.7",
    "iwer": "^2.2.1",
    "jimp": "^1.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  }
}
