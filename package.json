{
  "name": "ci-spatial-web",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "verify": "deno task check && deno task test && tsc --noEmit && npm run typecheck:tests && npm run test:pipeline:graph && npm run test:editor:pick && npm run test:store && npm run test:resolver && npm run test:provenance && npm run test:detection-gate && npm run test:model-provisioning && npm run test:router && npm run test:clock-sync && npm run test:clip-validation && npm run test:splat4d && npm run test:gimbal:stall && npm run test:gimbal:control && npm run test:gimbal:link && npm run test:gimbal:protocol && npm run test:tracking:quality && npm run test:object:filter && npm run test:status-line && npm run test:panoptic:lift && npm run test:wake-lock && npm run test:ar:preflight && npm run test:scan:lighting && npm run test:upload:expectation && npm run test:capture:intent && npm run test:capture:station && npm run test:capture:distance && npm run test:capture:sweep",
    "test:pipeline:graph": "node --experimental-strip-types --no-warnings --test tests/unit/node/pipeline_detection_graph.test.ts",
    "test:editor:pick": "node --experimental-strip-types --no-warnings --test tests/unit/node/editor_pick.test.ts",
    "test:store": "node --experimental-strip-types --no-warnings --test tests/unit/node/detection_store.test.ts",
    "test:provenance": "node --experimental-strip-types --no-warnings --test tests/unit/node/glb_provenance.test.ts",
    "test:resolver": "node --experimental-strip-types --no-warnings --test tests/unit/node/resolver.test.ts",
    "test:detection-gate": "node --experimental-strip-types --no-warnings --test tests/unit/node/detection_gate.test.ts",
    "test:model-provisioning": "node --experimental-strip-types --no-warnings --test tests/unit/node/model_provisioning.test.ts",
    "test:router": "node --experimental-strip-types --no-warnings --test tests/unit/node/inference_router.test.ts",
    "test:clock-sync": "node --experimental-strip-types --no-warnings --test tests/unit/node/clock_sync.test.ts",
    "test:clip-validation": "node --experimental-strip-types --no-warnings --test tests/unit/node/clip_validation.test.ts",
    "test:splat4d": "node --experimental-strip-types --no-warnings --test tests/unit/node/splat4d_window.test.ts",
    "test:status-line": "node --experimental-strip-types --no-warnings --test tests/unit/node/status_line.test.ts",
    "test:ar:preflight": "node --experimental-strip-types --no-warnings --test tests/unit/node/ar_preflight.test.ts",
    "test:scan:lighting": "node --experimental-strip-types --no-warnings --test tests/unit/node/scan_lighting.test.ts",
    "preview": "vite preview --host",
    "server": "deno run --env-file --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run server/main.ts",
    "start": "concurrently --raw --names \"infer,vite\" -c \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "gen-icons": "node scripts/generate-icons.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "postinstall": "node scripts/copy-draco.mjs && node scripts/copy-ort-wasm.mjs && node scripts/postinstall-hint.mjs",
    "smoke:pipeline": "node scripts/smoke-pipeline.mjs",
    "test:lingbot:glb": "node --experimental-strip-types --no-warnings --test tests/unit/node/lingbot_map_glb.test.ts",
    "test:lingbot:fetch-video": "node scripts/fetch-lingbot-test-video.mjs",
    "test:lingbot:make-fixture": "node scripts/make-lingbot-fixture.mjs",
    "test:splat:make-fixture": "node scripts/make-splat-fixture.mjs",
    "test:splat:unit": "deno test --allow-read --allow-write --allow-env --allow-run tests/unit/deno/splat_train.test.ts tests/unit/deno/splat_detect.test.ts tests/unit/deno/splat_finish.test.ts tests/unit/deno/splat_align.test.ts tests/unit/deno/splat_train_colmap_args.test.ts tests/unit/deno/spirula_train.test.ts",
    "test:mock:unit": "deno test --allow-read --allow-env --allow-net tests/unit/deno/inference_mock.test.ts",
    "test:auth:unit": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run tests/unit/deno/portal_auth.test.ts tests/unit/deno/memory_push.test.ts tests/unit/deno/lingbot_map.test.ts",
    "test:deno": "deno task test",
    "gen:test-data": "node scripts/generate-test-homes.mjs && node scripts/generate-cv-images.mjs",
    "seed:test-data": "node scripts/seed-test-homes.mjs",
    "eval:cv": "node scripts/eval-cv.mjs",
    "accept:detection-baseline": "node scripts/accept-detection-baseline.mjs",
    "check:detection-gate": "node scripts/check-detection-gate.mjs",
    "gate:mock": "node scripts/ci-mock-gate.mjs",
    "test:api": "playwright test --project=api",
    "test:mock": "playwright test --project=chromium-mock",
    "test:tablet-user": "node scripts/tablet-user-suite.mjs",
    "test": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=webkit-iphone15",
    "test:iphone": "playwright test --project=iphone-usb",
    "logs:iphone": "node scripts/iwdp-console.mjs ws://localhost:9222/devtools/page/2",
    "logs:watch": "node scripts/logs-watch.mjs",
    "test:box": "node scripts/test-box.mjs",
    "bench:models": "node scripts/bench-models.mjs",
    "setup:models": "node scripts/setup-models.mjs",
    "qr": "node scripts/qr.mjs",
    "ingest:video": "node scripts/ingest-video.mjs",
    "ingest:photos": "node scripts/ingest-photos.mjs",
    "links:house": "node scripts/house-links.mjs",
    "test:house": "playwright test --project=api house-readiness",
    "tune:detect": "node scripts/tune-splat-detect.mjs",
    "loop": "node scripts/loop.mjs",
    "loop:full": "node scripts/loop.mjs --tier=5",
    "loop:baseline": "node scripts/loop.mjs --only=ui-full --update-baseline",
    "test:gimbal:stall": "node --experimental-strip-types --no-warnings --test tests/unit/node/gimbal_stall.test.ts",
    "test:gimbal:control": "node --experimental-strip-types --no-warnings --test tests/unit/node/gimbal_control.test.ts",
    "test:gimbal:link": "node --experimental-strip-types --no-warnings --test tests/unit/node/gimbal_link_state.test.ts",
    "test:gimbal:protocol": "node --test subsystems/osmo-ble/protocol/duml.test.mjs subsystems/osmo-ble/protocol/dome.test.mjs subsystems/osmo-ble/protocol/device_registry.test.mjs",
    "audit:scan": "node --experimental-strip-types --no-warnings scripts/audit-scan-glb.mjs",
    "test:tracking:quality": "node --experimental-strip-types --no-warnings --test tests/unit/node/tracking_quality.test.ts",
    "test:object:filter": "node --experimental-strip-types --no-warnings --test tests/unit/node/object_filter.test.ts",
    "test:panoptic:lift": "node --experimental-strip-types --no-warnings --test tests/unit/node/panoptic_lift.test.ts",
    "test:wake-lock": "node --experimental-strip-types --no-warnings --test tests/unit/node/wake_lock.test.ts",
    "test:upload:expectation": "node --experimental-strip-types --no-warnings --test tests/unit/node/upload_expectation.test.ts",
    "test:capture:intent": "node --experimental-strip-types --no-warnings --test tests/unit/node/capture_intent.test.ts",
    "test:capture:station": "node --experimental-strip-types --no-warnings --test tests/unit/node/station_capture.test.ts",
    "test:capture:distance": "node --experimental-strip-types --no-warnings --test tests/unit/node/spot_distance.test.ts",
    "test:capture:sweep": "node --experimental-strip-types --no-warnings --test tests/unit/node/sweep_cadence.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@sparkjsdev/spark": "^2.1.0",
    "leaflet": "1.9.4",
    "onnxruntime-web": "~1.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@playcanvas/splat-transform": "^2.7.1",
    "@playwright/test": "1.59.0",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.1",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.3",
    "draco3dgltf": "^1.5.7",
    "iwer": "^2.2.1",
    "jimp": "^1.6.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  }
}
