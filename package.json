{
  "name": "ci-spatial-web",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "verify": "deno task check && deno task test && tsc --noEmit && npm run test:pipeline:graph && npm run test:editor:pick && npm run test:store && npm run test:resolver && npm run test:provenance",
    "test:pipeline:graph": "node --experimental-strip-types --no-warnings --test tests/unit/node/pipeline_detection_graph.test.ts",
    "test:editor:pick": "node --experimental-strip-types --no-warnings --test tests/unit/node/editor_pick.test.ts",
    "test:store": "node --experimental-strip-types --no-warnings --test tests/unit/node/detection_store.test.ts",
    "test:provenance": "node --experimental-strip-types --no-warnings --test tests/unit/node/glb_provenance.test.ts",
    "test:resolver": "node --experimental-strip-types --no-warnings --test tests/unit/node/resolver.test.ts",
    "preview": "vite preview --host",
    "server": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run server/main.ts",
    "start": "concurrently --raw --names \"infer,vite\" -c \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "gen-icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/copy-draco.mjs && node scripts/postinstall-hint.mjs",
    "smoke:pipeline": "node scripts/smoke-pipeline.mjs",
    "test:lingbot:glb": "node --experimental-strip-types --no-warnings --test tests/unit/node/lingbot_map_glb.test.ts",
    "test:lingbot:fetch-video": "node scripts/fetch-lingbot-test-video.mjs",
    "test:lingbot:make-fixture": "node scripts/make-lingbot-fixture.mjs",
    "test:splat:make-fixture": "node scripts/make-splat-fixture.mjs",
    "test:splat:unit": "deno test --allow-read --allow-write --allow-env --allow-run tests/unit/deno/splat_train.test.ts tests/unit/deno/splat_detect.test.ts tests/unit/deno/splat_finish.test.ts",
    "test:mock:unit": "deno test --allow-read --allow-env --allow-net tests/unit/deno/inference_mock.test.ts",
    "test:auth:unit": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run tests/unit/deno/portal_auth.test.ts tests/unit/deno/memory_push.test.ts tests/unit/deno/lingbot_map.test.ts",
    "test:deno": "deno task test",
    "gen:test-data": "node scripts/generate-test-homes.mjs && node scripts/generate-cv-images.mjs",
    "seed:test-data": "node scripts/seed-test-homes.mjs",
    "eval:cv": "node scripts/eval-cv.mjs",
    "test:api": "playwright test --project=api",
    "test:mock": "playwright test --project=chromium-mock",
    "test:tablet-user": "node scripts/tablet-user-suite.mjs",
    "test": "playwright test --project=webkit-desktop",
    "test:mobile": "playwright test --project=webkit-iphone15",
    "test:iphone": "playwright test --project=iphone-usb",
    "logs:iphone": "node scripts/iwdp-console.mjs ws://localhost:9222/devtools/page/2",
    "logs:watch": "node scripts/logs-watch.mjs",
    "test:box": "node scripts/test-box.mjs",
    "bench:models": "node scripts/bench-models.mjs",
    "setup:models": "node scripts/setup-models.mjs",
    "qr": "node scripts/qr.mjs",
    "ingest:video": "node scripts/ingest-video.mjs",
    "ingest:photos": "node scripts/ingest-photos.mjs",
    "links:house": "node scripts/house-links.mjs",
    "test:house": "playwright test --project=api house-readiness",
    "tune:detect": "node scripts/tune-splat-detect.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@sparkjsdev/spark": "^2.1.0",
    "leaflet": "1.9.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@playcanvas/splat-transform": "^2.7.1",
    "@playwright/test": "1.59.0",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.1",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.3",
    "draco3dgltf": "^1.5.7",
    "iwer": "^2.2.1",
    "jimp": "^1.6.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  }
}
