# macOS / Windows
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / temp / cache
build/
dist/
out/
tmp/
temp/
.cache/
.runtime/

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Project-generated outputs
outputs/
exports/
renders/

# Model files — large binaries, download separately via download_models.py
public/models/

# Stray copies of the same model metadata, if download_models.py is ever run
# from the repo root instead of into public/models/.
/config.json
/generation_config.json
/processor_config.json
/chat_template.jinja
onnx/
tokenizer.json
tokenizer_config.json
*.onnx
*.onnx_data
test-results/
# Project registry written by the server at runtime (PROJECTS_FILE). Same class
# as scans/ and worlds/ below — loadProjects() seeds a default when it is absent,
# so a fresh clone does not need it committed.
/projects.json
scans/
summaries/
worlds/

# TLS certificates (tailscale cert output) — machine-local, never commit
*.crt
*.key

# Local test-run isolation dirs (npm run test:box, npm run bench:models)
.test-run/
.bench-run/

# Draco decoder — copied from node_modules by scripts/copy-draco.mjs (postinstall)
public/draco/

# onnxruntime-web WASM/JSEP runtime — copied from node_modules by
# scripts/copy-ort-wasm.mjs (postinstall)
public/ort/

.agents/*

# Generated test fixtures — npm run gen:test-data (test-data/cv/). The real-photograph
# corpus below is checked in, not generated — see test-data/real/README.md.
test-data/*
!test-data/real/
!test-data/real/**

# LingBot-Map reference clip — fetched on demand via npm run test:lingbot:fetch-video.
# Large CC-BY video; only LICENSE.txt is committed.
tests/fixtures/lingbot-map/source.mp4
tests/fixtures/lingbot-map/*.webm
tests/fixtures/lingbot-map/*.mov

# Claude Code MCP local overrides — machine-local secrets (bearer tokens,
# personal paths). Highest precedence over the checked-in .mcp.json.
.mcp.local.json

# Claude Code per-machine settings. Its `env` block is one way to feed the
# android-* bearer tokens to Claude Code, so it can hold secrets. Claude Code
# often ignores it only through the user's *global* gitignore, which protects
# nobody else's clone, nor a copy written by hand or by a script.
.claude/settings.local.json

# Claude Code preview/launch config — the dev-server URL embeds this machine's
# Tailscale hostname, which vite.config.ts resolveHostname() derives per box.
# Copy .claude/launch.json.example and fill in your own hostname.
.claude/launch.json
