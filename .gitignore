# macOS / Windows
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build / temp / cache
build/
dist/
out/
tmp/
temp/
.cache/
.runtime/

# Logs
*.log

# Environment files
.env
.env.*
!.env.example

# Project-generated outputs
outputs/
exports/
renders/

# Model files — large binaries, download separately via download_models.py
public/models/
onnx/
tokenizer.json
tokenizer_config.json
*.onnx
*.onnx_data
test-results/
scans/
summaries/
worlds/

# TLS certificates (tailscale cert output) — machine-local, never commit
*.crt
*.key

# Local test-run isolation dirs (npm run test:box, npm run bench:models)
.test-run/
.bench-run/

# Draco decoder — copied from node_modules by scripts/copy-draco.mjs (postinstall)
public/draco/

.agents/*

# Generated test fixtures — npm run gen:test-data
test-data/

# LingBot-Map reference clip — fetched on demand via npm run test:lingbot:fetch-video.
# Large CC-BY video; only LICENSE.txt is committed.
tests/fixtures/lingbot-map/source.mp4
tests/fixtures/lingbot-map/*.webm
tests/fixtures/lingbot-map/*.mov

# Claude Code MCP local overrides — machine-local secrets (bearer tokens,
# personal paths). Highest precedence over the checked-in .mcp.json.
.mcp.local.json
