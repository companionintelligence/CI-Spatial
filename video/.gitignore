# rendered videos — regenerate with `ci-video render`
out/

# generated compositions — derived from storyboard.json by `ci-video build`,
# and rebuilt by the workflow before every check/render. A committed copy is
# never read and goes stale on the first storyboard edit.
build/

# playwright auth state
.auth/

node_modules/

# assets/shots/ is deliberately NOT ignored, and must not be added here.
# Fleet policy as of 2026-08-05: shots are committed inputs. Only three of the
# twelve products have a working capture stage, so a gitignored shot set means
# nobody but the stage's author can render the cut — which is how eleven of the
# twelve ended up rendering as "capture pending" slates. The PNGs are also the
# only reviewable record of what the UI looked like: captures are byte-stable,
# so a diff in them means the product genuinely moved.
