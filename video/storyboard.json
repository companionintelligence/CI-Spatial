{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-web-xr-scan",
    "name": "Companion Scan",
    "repo": "companionintelligence/CI-Web-XR-Scan",
    "marketplaceId": "ci-web-xr-scan",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5
  },
  "chapters": {
    "setup": "Before you scan",
    "capture": "Scanning a room",
    "editor": "In the 3D editor"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "open",
      "kind": "intro",
      "seconds": 5,
      "title": "Companion Scan",
      "caption": "Walk the room. Keep the map.",
      "narration": "Companion Scan turns a walk through a room into a 3D map."
    },
    {
      "id": "ftue-permissions",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5.5,
      "caption": "Camera sees the room. Motion tracks you.",
      "narration": "The camera sees the room. Motion sensors track where you are.",
      "shots": [
        {
          "id": "onboard-permissions",
          "url": "companion-scan.local",
          "alt": "First onboarding step explaining that Companion Scan needs camera and motion access",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "settle": 500
          }
        }
      ]
    },
    {
      "id": "ftue-capture-modes",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 6,
      "caption": "Tap a frame, auto-capture, or stream keyframes.",
      "narration": "Tap a frame, auto-capture as you walk, or stream keyframes.",
      "shots": [
        {
          "id": "onboard-capture-modes",
          "url": "companion-scan.local",
          "alt": "Onboarding step three listing the three capture modes",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='2'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "ftue-quality",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5.5,
      "caption": "Low light, reflections, thin coverage — called out live.",
      "narration": "You know when a room is finished scanning, before you walk out of it.",
      "shots": [
        {
          "id": "onboard-quality",
          "url": "companion-scan.local",
          "alt": "Onboarding step four explaining live scan-quality tracking for low light, reflective surfaces and sparse coverage",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='3'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "ftue-finish",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5.5,
      "caption": "Export a GLB. Open it in 3D.",
      "narration": "When you're done, export the scan and open it in the desktop editor.",
      "shots": [
        {
          "id": "onboard-finish",
          "url": "companion-scan.local",
          "alt": "Final onboarding step covering GLB export and the 3D editor",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='4'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "choose-your-path",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 6.5,
      "caption": "Two ways in. Both end in a map.",
      "narration": "Scan a room with the camera, or upload a walkthrough video you already have.",
      "shots": [
        {
          "id": "start-screen",
          "url": "companion-scan.local",
          "alt": "Start screen offering two equal paths: scan a room, or upload a video",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8",
            "waitFor": "#start-ar-btn",
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "live-scan",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 7,
      "caption": "Points build as you walk.",
      "narration": "Walk slowly and the point cloud fills in. The quality chip says when it's enough.",
      "shots": [
        {
          "id": "live-scan-hud",
          "url": "companion-scan.local",
          "alt": "Live scanning heads-up display over the camera feed, with capture controls",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "wait": 2500 }
            ],
            "settle": 600,
            "mask": [
              "#scan-stats",
              "#status-text",
              "#verdict-chip",
              "#quality-coverage-text",
              "#quality-coverage-fill",
              "#quality-drift-badge",
              "#geo-chip"
            ]
          }
        }
      ]
    },
    {
      "id": "objects-named",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 6.5,
      "caption": "Every object named, placed and yours.",
      "narration": "Objects come back named and placed, identified on hardware you own.",
      "shots": [
        {
          "id": "detections-panel",
          "url": "companion-scan.local",
          "alt": "Review panel listing the objects one capture found, each with a label, a confidence figure and its position in the room",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "wait": 2500 },
              { "click": "#capture-btn" },
              { "waitFor": "#panel-content [data-key]" },
              { "click": "#panel-toggle" },
              { "waitFor": "#side-panel.open" },
              { "wait": 2000 }
            ],
            "settle": 600,
            "mask": [
              "#scan-stats",
              "#status-text",
              "#verdict-chip",
              "#quality-coverage-text",
              "#quality-coverage-fill",
              "#quality-drift-badge",
              "#geo-chip",
              "#autosave-status",
              "#panel-content [data-key] div[style*=\"monospace\"]"
            ]
          }
        }
      ]
    },
    {
      "id": "review-and-export",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 6,
      "caption": "Review the scan. Export a file you own.",
      "narration": "Review everything the scan found, then export it as a file you own.",
      "shots": [
        {
          "id": "review-export-panel",
          "url": "companion-scan.local",
          "alt": "The Review and Export panel, with GLB export, summary export and server-processing actions in the footer",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "wait": 2500 },
              { "click": "#capture-btn" },
              { "waitFor": "#panel-content [data-key]" },
              { "click": "#finish-scan-btn" },
              { "waitFor": "#side-panel.open #panel-export-glb-btn" },
              { "wait": 2000 }
            ],
            "settle": 600,
            "mask": [
              "#scan-stats",
              "#status-text",
              "#verdict-chip",
              "#quality-coverage-text",
              "#quality-coverage-fill",
              "#quality-drift-badge",
              "#geo-chip",
              "#autosave-status",
              "#panel-content [data-key] div[style*=\"monospace\"]"
            ]
          }
        }
      ]
    },
    {
      "id": "world-editor",
      "kind": "screen",
      "chapter": "editor",
      "seconds": 6.5,
      "caption": "Every room, one world, your server.",
      "narration": "Every room you scan lands in one 3D world, stored on your own server.",
      "shots": [
        {
          "id": "world-editor-scans",
          "url": "companion-scan.local/viewer.html",
          "alt": "The desktop World Editor with several room scans composed into one 3D world",
          "motion": "push-in",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "wait": 8000 }
            ],
            "settle": 800,
            "mask": [
              ".scan-status",
              "#world-job-count"
            ]
          }
        }
      ]
    },
    {
      "id": "semantic-world",
      "kind": "screen",
      "chapter": "editor",
      "seconds": 7,
      "caption": "Named objects, not an anonymous point cloud.",
      "narration": "The map is not just geometry. Every object keeps the label it was given.",
      "shots": [
        {
          "id": "world-editor-semantic",
          "url": "companion-scan.local/viewer.html",
          "alt": "Semantic view of the world, colouring the scene by the label attached to each detected object",
          "motion": "drift-down",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "wait": 8000 },
              { "click": "#mode-semantic" },
              { "waitFor": "#mode-semantic.active" },
              { "wait": 2000 }
            ],
            "settle": 800,
            "mask": [
              ".scan-status",
              "#world-job-count"
            ]
          }
        }
      ]
    },
    {
      "id": "what-you-get",
      "kind": "feature",
      "seconds": 6,
      "caption": "Local capture, self-hosted pipeline.",
      "narration": "It runs in the browser on your phone and sends scans to your own server.",
      "items": [
        { "label": "Runs on", "value": "Your phone" },
        { "label": "Capture", "value": "Live AR or video" },
        { "label": "Output", "value": "GLB + point cloud" },
        { "label": "Sends to", "value": "Your own server" }
      ]
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 5,
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Companion Scan. UnCloud your life."
    }
  ]
}
