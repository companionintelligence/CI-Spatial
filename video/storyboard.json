{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-web-xr-scan",
    "name": "Companion Scan",
    "repo": "companionintelligence/CI-Web-XR-Scan",
    "marketplaceId": "ci-web-xr-scan",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5
  },
  "chapters": {
    "setup": "Before you scan",
    "capture": "Scanning a room",
    "editor": "In the 3D editor"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "open",
      "kind": "intro",
      "seconds": 5,
      "title": "Companion Scan",
      "caption": "Walk the room. Keep the map.",
      "narration": "Companion Scan turns a walk through a room into a 3D map."
    },
    {
      "id": "choose-your-path",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 6.5,
      "caption": "Two ways in. Both end in a map.",
      "narration": "Scan a room with the camera, or upload a walkthrough video you already have.",
      "shots": [
        {
          "id": "start-screen",
          "url": "companion-scan.local",
          "alt": "Start screen offering two equal paths: scan a room, or upload a video",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8",
            "waitFor": "#start-ar-btn",
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "ftue-permissions",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 7,
      "caption": "Camera sees the room. You walk it slowly.",
      "narration": "The camera sees the room, motion tracks you, and a slow sweep keeps tracking locked.",
      "shots": [
        {
          "id": "onboard-permissions",
          "url": "companion-scan.local",
          "alt": "First onboarding step explaining that Companion Scan needs camera and motion access",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "settle": 500
          }
        },
        {
          "id": "onboard-sweep",
          "url": "companion-scan.local",
          "alt": "Second onboarding step, Sweep the Room Slowly, explaining that moving too fast degrades SLAM tracking and that the live point cloud shows what has been covered",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='1'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "ftue-capture-modes",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 6,
      "caption": "Tap a frame, auto-capture, or stream keyframes.",
      "narration": "Tap a frame, auto-capture as you walk, or stream keyframes.",
      "shots": [
        {
          "id": "onboard-capture-modes",
          "url": "companion-scan.local",
          "alt": "Onboarding step three listing the three capture modes",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='2'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "ftue-quality",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5.5,
      "caption": "Low light, reflections, thin coverage — called out live.",
      "narration": "You know when a room is finished scanning, before you walk out of it.",
      "shots": [
        {
          "id": "onboard-quality",
          "url": "companion-scan.local",
          "alt": "Onboarding step four explaining live scan-quality tracking for low light, reflective surfaces and sparse coverage",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='3'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "ftue-finish",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5.5,
      "caption": "Export a GLB. Open it in 3D.",
      "narration": "When you're done, export the scan and open it in the desktop editor.",
      "shots": [
        {
          "id": "onboard-finish",
          "url": "companion-scan.local",
          "alt": "Final onboarding step covering GLB export and the 3D editor",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&onboarding=1",
            "waitFor": "#onboarding-overlay.visible",
            "before": [
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "click": "#onboard-next-btn" },
              { "waitFor": ".onboard-step[data-step='4'].active" }
            ],
            "settle": 400
          }
        }
      ]
    },
    {
      "id": "live-scan",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 7.5,
      "caption": "Thin at first. Full as you walk.",
      "narration": "Walk the room and the map fills in, with coverage scored live as you go.",
      "shots": [
        {
          "id": "live-scan-early",
          "url": "companion-scan.local",
          "alt": "The scanning HUD a few seconds into the walk, with a thin point count, a low coverage bar and the live quality recommendation the app raises for a sparse map",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&mockFreeze=90",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "waitFor": "#scan-stats:has-text('pts')" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#geo-chip{display:none!important}</style>')" }
            ],
            "settle": 600
          }
        },
        {
          "id": "live-scan-hud",
          "url": "companion-scan.local",
          "alt": "The same scanning HUD later in the walk, with the point count in the thousands and the coverage bar reading Good",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&mockFreeze=700",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "waitFor": "#scan-stats:has-text('pts')" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#geo-chip{display:none!important}</style>')" }
            ],
            "settle": 600
          }
        }
      ]
    },
    {
      "id": "objects-named",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 7,
      "caption": "Every object named, placed and yours.",
      "narration": "Objects come back named and placed, identified on hardware you own.",
      "shots": [
        {
          "id": "detections-panel",
          "url": "companion-scan.local",
          "alt": "The Latest scan readout over the camera feed, listing objects this capture found with a label, a confidence figure and a 3D position each",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&mockFreeze=700",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "waitFor": "#scan-stats:has-text('pts')" },
              { "click": "#capture-btn" },
              { "waitFor": "#infer-dialog.visible" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#status-bar,#quality-overlay,#autosave-status{display:none!important}</style>')" }
            ],
            "settle": 600
          }
        },
        {
          "id": "objects-manifest",
          "url": "companion-scan.local",
          "alt": "The object manifest at the top of the side panel, counting the objects found and listing each one with its label, confidence and X Y Z position",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&mockFreeze=700",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "waitFor": "#scan-stats:has-text('pts')" },
              { "click": "#capture-btn" },
              { "waitFor": "#panel-content [data-key]" },
              { "click": "#panel-toggle" },
              { "waitFor": "#side-panel.open #panel-content [data-key]" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#hud-panel,#scanner-action-rail{display:none!important}</style>')" }
            ],
            "settle": 600
          }
        }
      ]
    },
    {
      "id": "review-and-export",
      "kind": "screen",
      "chapter": "capture",
      "seconds": 7,
      "caption": "Review the scan. Export a file you own.",
      "narration": "Review everything the scan found, then export it as a file you own.",
      "shots": [
        {
          "id": "review-panel-empty",
          "url": "companion-scan.local",
          "alt": "The Review and Export panel opened before the first capture, empty apart from the prompt to tap the capture button to scan",
          "motion": "push-in",
          "capture": {
            "path": "/?mock=xr8&mockFreeze=700",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "waitFor": "#scan-stats:has-text('pts')" },
              { "click": "#panel-toggle" },
              { "waitFor": "#side-panel.open #panel-content:has-text('No objects yet')" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#hud-panel,#scanner-action-rail{display:none!important}</style>')" }
            ],
            "settle": 600
          }
        },
        {
          "id": "review-export-panel",
          "url": "companion-scan.local",
          "alt": "The same panel after a capture, with the object list filled in and GLB export, summary export and server-processing actions in the footer",
          "motion": "drift-down",
          "capture": {
            "path": "/?mock=xr8&mockFreeze=700",
            "waitFor": "#start-ar-btn",
            "before": [
              { "click": "#start-ar-btn" },
              { "waitFor": "#capture-btn" },
              { "waitFor": "#scan-stats:has-text('pts')" },
              { "click": "#capture-btn" },
              { "waitFor": "#panel-content [data-key]" },
              { "click": "#finish-scan-btn" },
              { "waitFor": "#side-panel.open #panel-export-glb-btn" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#hud-panel,#scanner-action-rail{display:none!important}</style>')" }
            ],
            "settle": 600
          }
        }
      ]
    },
    {
      "id": "world-editor",
      "kind": "screen",
      "chapter": "editor",
      "seconds": 7,
      "caption": "Every room, one world, your server.",
      "narration": "Every room you scan lands in one 3D world, stored on your own server.",
      "shots": [
        {
          "id": "world-editor-scans",
          "url": "companion-scan.local/viewer.html",
          "alt": "The World Editor with three room scans listed in the sidebar, each one ready and optimized, and the camera framed on the selected room",
          "motion": "drift-down",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "waitFor": "#scan-list .scan-item:nth-child(1) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(2) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(3) .scan-status:has-text('Ready - optimized')" },
              { "click": "#btn-reset-camera" },
              { "wait": 600 },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#coord-readout{display:none!important}</style>')" }
            ],
            "settle": 1200
          }
        },
        {
          "id": "world-editor-focus",
          "url": "companion-scan.local/viewer.html",
          "alt": "The same world after picking the second room from the sidebar: the camera has flown to that scan and the Edit tab has opened on its name, confidence and tags",
          "motion": "push-in",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "waitFor": "#scan-list .scan-item:nth-child(1) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(2) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(3) .scan-status:has-text('Ready - optimized')" },
              { "click": "#scan-list .scan-item:nth-child(2)" },
              { "waitFor": "#tab-edit.active #edit-selected-info" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#coord-readout{display:none!important}</style>')" }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "semantic-world",
      "kind": "screen",
      "chapter": "editor",
      "seconds": 7.5,
      "caption": "Named objects, not an anonymous point cloud.",
      "narration": "The map is not just geometry. Every object keeps the label it was given.",
      "shots": [
        {
          "id": "world-editor-points",
          "url": "companion-scan.local/viewer.html",
          "alt": "The world drawn as a raw point cloud, with Points selected in the view-mode toolbar",
          "motion": "push-in",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "waitFor": "#scan-list .scan-item:nth-child(1) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(2) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(3) .scan-status:has-text('Ready - optimized')" },
              { "click": "#btn-reset-camera" },
              { "wait": 600 },
              { "click": "#mode-points" },
              { "waitFor": "#mode-points.active" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#coord-readout{display:none!important}</style>')" }
            ],
            "settle": 1200
          }
        },
        {
          "id": "world-editor-semantic",
          "url": "companion-scan.local/viewer.html",
          "alt": "Semantic view of the same world, colouring the scene by the label attached to each detected object",
          "motion": "drift-down",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "waitFor": "#scan-list .scan-item:nth-child(1) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(2) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(3) .scan-status:has-text('Ready - optimized')" },
              { "click": "#btn-reset-camera" },
              { "wait": 600 },
              { "click": "#mode-semantic" },
              { "waitFor": "#mode-semantic.active" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#coord-readout{display:none!important}</style>')" }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "map-quality",
      "kind": "screen",
      "chapter": "editor",
      "seconds": 7,
      "caption": "Preview. Reconstructed. Photoreal.",
      "narration": "Every scan can be upgraded to a photoreal map, on hardware you already own.",
      "shots": [
        {
          "id": "world-editor-quality",
          "url": "companion-scan.local/viewer.html",
          "alt": "The Layers tab showing the Map Quality stepper — Preview, Reconstructed, Photoreal — with the selected scan's current tier lit and the next step spelled out",
          "motion": "push-in",
          "capture": {
            "path": "/viewer.html?world=default",
            "waitFor": "#scan-list .scan-item",
            "before": [
              { "waitFor": "#scan-list .scan-item:nth-child(1) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(2) .scan-status:has-text('Ready - optimized')" },
              { "waitFor": "#scan-list .scan-item:nth-child(3) .scan-status:has-text('Ready - optimized')" },
              { "click": "#btn-reset-camera" },
              { "wait": 600 },
              { "click": "#tab-btn-layers" },
              { "waitFor": "#tab-layers.active #quality-stepper .quality-step.current" },
              { "eval": "() => document.head.insertAdjacentHTML('beforeend', '<style>#coord-readout{display:none!important}</style>')" }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "what-you-get",
      "kind": "feature",
      "seconds": 6,
      "caption": "Local capture, self-hosted pipeline.",
      "narration": "It runs in the browser on your phone and sends scans to your own server.",
      "items": [
        { "label": "Monthly fee", "value": "$0" },
        { "label": "Capture", "value": "Live AR or video" },
        { "label": "Output", "value": "GLB + point cloud" },
        { "label": "Inference", "value": "Your hardware" }
      ]
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 5,
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Companion Scan. UnCloud your life."
    }
  ]
}
