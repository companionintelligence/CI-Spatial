{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --env-file --watch --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run server/main.ts",
    "start": "deno run --env-file --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run server/main.ts",
    "check": "deno check server/main.ts",
    "migrate-jobs": "deno run --allow-read --allow-write --allow-env server/migrations/migrate_jobs.ts",
    "migrate-scan-ids": "deno run --allow-read --allow-write --allow-env server/migrations/migrate_scan_ids.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run tests/unit/deno/",
    "test:mock": "deno test --allow-read --allow-env --allow-net tests/unit/deno/inference_mock.test.ts",
    "test:splat": "deno test --allow-read --allow-write --allow-env --allow-run tests/unit/deno/splat_train.test.ts tests/unit/deno/splat_detect.test.ts tests/unit/deno/splat_finish.test.ts",
    "test:auth": "deno test --allow-read --allow-write --allow-env --allow-net --allow-run tests/unit/deno/portal_auth.test.ts tests/unit/deno/memory_push.test.ts tests/unit/deno/lingbot_map.test.ts"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.0",
    "hono": "npm:hono@^4.7.0",
    "hono/cors": "npm:hono@^4.7.0/cors",
    "hono/logger": "npm:hono@^4.7.0/logger",
    "onnxruntime-node": "npm:onnxruntime-node@^1.21.0",
    "jimp": "npm:jimp@^1.6.1",
    "@gltf-transform/core": "npm:@gltf-transform/core@^4.4.0",
    "@gltf-transform/extensions": "npm:@gltf-transform/extensions@^4.4.0",
    "@gltf-transform/functions": "npm:@gltf-transform/functions@^4.4.0",
    "draco3dgltf": "npm:draco3dgltf@^1.5.7",
    "jose": "npm:jose@^5.9.6"
  },
  "allowScripts": ["npm:onnxruntime-node@1.21.0", "npm:onnxruntime-node@1.24.3"]
}
