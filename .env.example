# Companion Scan configuration (documentation only — none of these are required).
# Vite reads process.env; the Deno server reads Deno.env. Export them in your
# shell or a systemd EnvironmentFile (see docs/DEPLOY.md); .env files are NOT
# loaded automatically.

# HTTPS hostname phones use to reach this machine. Auto-detected from
# `tailscale status --json` (or a <host>.ts.net.crt in the repo root) when unset.
#TAILSCALE_HOSTNAME=your-machine.your-tailnet.ts.net

# Origin prefix accepted by the Deno server's CORS check and used for share
# links. Defaults to https://$TAILSCALE_HOSTNAME, else the historical dev host.
#ALLOWED_ORIGIN_PREFIX=https://your-machine.your-tailnet.ts.net

# Deno API server port (default 8000) and the target the Vite proxy forwards
# to (default http://localhost:8000) — override both to run isolated instances.
#PORT=8000
#API_TARGET=http://localhost:8000

# Inference engine: ollama (default) | onnx | mock
#INFERENCE_MODE=ollama
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=moondream:latest

# /infer request cap in bytes (default 12000000)
#INFER_MAX_IMAGE_BYTES=12000000

# Playwright: base URL for browser tests (defaults to https://$TAILSCALE_HOSTNAME:5173)
#VITE_URL=https://your-machine.your-tailnet.ts.net:5173
# Chromium binary override for hosts where `npx playwright install` is unsupported
#CHROMIUM_EXECUTABLE_PATH=~/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome

# LingBot-Map reconstruction worker (optional; jobs report a hint when unset)
#LINGBOT_MAP_PYTHON=~/.venvs/lingbot-map/bin/python
#LINGBOT_MAP_MODEL_PATH=~/models/lingbot-map/checkpoint.pt
