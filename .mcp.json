{
  "mcpServers": {
    "android-tab-s8-ultra": {
      "type": "http",
      "url": "http://127.0.0.1:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${ANDROID_MCP_TOKEN}"
      }
    },
    "android-tab-s8-ultra-tunnel": {
      "type": "http",
      "url": "${ANDROID_MCP_TUNNEL_URL}",
      "headers": {
        "Authorization": "Bearer ${ANDROID_MCP_TOKEN}"
      }
    }
  }
}
