# Companion Scan service environment — installed to ~/.config/cscan/env by
# scripts/install-services.sh (edit THAT copy; this file is the template).
# Machine-local: never committed. Read by the cscan-* systemd user units.

# HTTPS hostname phones use (must match the tailscale cert)
TAILSCALE_HOSTNAME=__HOSTNAME__
ALLOWED_ORIGIN_PREFIX=https://__HOSTNAME__

# Deno API server
PORT=8000
INFERENCE_MODE=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=__OLLAMA_MODEL__

# Skip the vite build on cscan-web restart (set to 1 for fast restarts after
# config-only changes; unset after pulling new code)
#CSCAN_SKIP_BUILD=1

# systemd user units don't inherit your login shell PATH
PATH=__PATH__

# LingBot-Map reconstruction worker (merged from ~/.config/cscan/env.lingbot when present)
#LINGBOT_MAP_PYTHON=
#LINGBOT_MAP_MODEL_PATH=
#HIP_VISIBLE_DEVICES=1

# Splat-train worker (Brush). See docs/splat-train.md.
# BRUSH_BIN defaults to ~/brush/src/target/release/brush-cli.
# BRUSH_DEVICE pins the wgpu adapter (wgpu-native, NOT HIP) — "DiscreteGpu(1)"
# targets the non-Ollama 7900 XTX and avoids the llvmpipe software adapter.
#BRUSH_BIN=
#BRUSH_DEVICE=DiscreteGpu(1)
#BRUSH_TRAIN_ITERS=15000
#BRUSH_SH_DEGREE=2
#BRUSH_MAX_RES=1280

# Splat-detect worker (splat_analyzer: render → OWLv2 → 3D boxes). See docs/splat-detect.md.
# SPLAT_DETECT_PYTHON is the ROCm-torch venv interpreter (default ~/.venvs/splat-analyzer/bin/python).
# SPLAT_DETECT_DIR is the splat_analyzer checkout (default ~/splat_analyzer).
# SPLAT_DETECT_PROMPT is the default open-vocab label list; a per-job prompt overrides it.
#SPLAT_DETECT_PYTHON=
#SPLAT_DETECT_DIR=
#SPLAT_DETECT_PROMPT=sofa, chair, table, tv, lamp, plant, bed, desk, shelf, door, window

# Video ingest (/ingest-video) — reject uploads larger than this many bytes (default 1.5 GB).
#INGEST_MAX_VIDEO_BYTES=1500000000
