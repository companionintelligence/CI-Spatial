# Companion Scan service environment — installed to ~/.config/cscan/env by
# scripts/install-services.sh (edit THAT copy; this file is the template).
# Machine-local: never committed. Read by the cscan-* systemd user units.

# HTTPS hostname phones use (must match the tailscale cert)
TAILSCALE_HOSTNAME=__HOSTNAME__
ALLOWED_ORIGIN_PREFIX=https://__HOSTNAME__
# Same value, checked second by main.ts/vite.config.ts's resolveHostname() —
# leave unset; only needed if your deploy tooling names the variable
# VITE_HOSTNAME rather than TAILSCALE_HOSTNAME.
#VITE_HOSTNAME=__HOSTNAME__

# Deno API server
PORT=8000
INFERENCE_MODE=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=__OLLAMA_MODEL__

# Where the Deno server reads/writes persisted state, relative to its cwd.
# Leave unset unless this box's data volume is mounted somewhere else.
#SCANS_DIR=./scans
#SUMMARIES_DIR=./summaries
#SESSIONS_DIR=./scans/sessions
#WORLDS_DIR=./worlds
#PROJECT_MEDIA_DIR=./scans/projects

# Security: set to 1 to require a valid per-world member token (owner/editor/
# viewer/scanner share link) on every world route that doesn't explicitly
# allow anonymous access. Off by default (anonymous allowed) — turn on for
# any shared or multi-tenant deployment of this box.
#WORLD_STRICT_AUTH=1

# Skip the vite build on cscan-web restart (set to 1 for fast restarts after
# config-only changes; unset after pulling new code)
#CSCAN_SKIP_BUILD=1

# systemd user units don't inherit your login shell PATH
PATH=__PATH__

# LingBot-Map reconstruction worker (merged from ~/.config/cscan/env.lingbot when present)
#LINGBOT_MAP_PYTHON=
#LINGBOT_MAP_MODEL_PATH=
#HIP_VISIBLE_DEVICES=1

# Splat-train worker (Brush). See docs/splat-train.md.
# BRUSH_BIN defaults to ~/brush/src/target/release/brush-cli.
# BRUSH_DEVICE pins the wgpu adapter (wgpu-native, NOT HIP) — "DiscreteGpu(1)"
# targets the non-Ollama 7900 XTX and avoids the llvmpipe software adapter.
#BRUSH_BIN=
#BRUSH_DEVICE=DiscreteGpu(1)
#BRUSH_TRAIN_ITERS=15000
#BRUSH_SH_DEGREE=2
#BRUSH_MAX_RES=1280

# Splat-detect worker (splat_analyzer: render → OWLv2 → 3D boxes). See docs/splat-detect.md.
# SPLAT_DETECT_PYTHON is the ROCm-torch venv interpreter (default ~/.venvs/splat-analyzer/bin/python).
# SPLAT_DETECT_DIR is the splat_analyzer checkout (default ~/splat_analyzer).
# SPLAT_DETECT_PROMPT is the default open-vocab label list; a per-job prompt overrides it.
#SPLAT_DETECT_PYTHON=
#SPLAT_DETECT_DIR=
#SPLAT_DETECT_PROMPT=sofa, chair, table, tv, lamp, plant, bed, desk, shelf, door, window
# Point-renderer splat size fed to run_local.py's --renderer point leg.
#POINT_SPLAT_SIZE=6
# Detection tuning — set from a calibration sweep on a real room splat (see
# docs/SPLAT_DETECT_ROADMAP.md + scripts/tune-splat-detect.mjs). Leave the three
# clustering knobs unset to use run_local.py's own defaults (0.12 / 8 / 0.40).
# SPLAT_DETECT_QUALITY: low (24 views) | medium (90) | high (192). Default medium.
#SPLAT_DETECT_QUALITY=medium
#SPLAT_DETECT_SCORE_THRESHOLD=0.12
#SPLAT_DETECT_MIN_VOTES=8
#SPLAT_DETECT_MIN_PEAK_SCORE=0.40

# Splat-finish worker (@playcanvas/splat-transform: .splat.ply → .sog + .compressed.ply).
# Auto-chained after every successful splat-train; set SPLAT_FINISH_AUTO=0 to disable.
# SPLAT_FINISH_GPU picks the SOG-compression device: "cpu" (default — always works,
# <1s for ~19k gaussians, no contention with the Ollama/torch GPUs) or a WebGPU
# adapter index from `node node_modules/@playcanvas/splat-transform/bin/cli.mjs -L`
# (NOT a HIP id — dawn/Vulkan enumeration, see docs/splat-toolbox.md).
#SPLAT_FINISH_AUTO=1
#SPLAT_FINISH_GPU=cpu
#SPLAT_FINISH_SH_ITERS=10
#SPLAT_TRANSFORM_CLI=
# node binary used to run the splat-transform CLI (default: "node" on PATH).
#SPLAT_FINISH_NODE=node

# Video ingest (/ingest-video) — reject uploads larger than this many bytes (default 1.5 GB).
#INGEST_MAX_VIDEO_BYTES=1500000000
# Photo ingest (/ingest-photos) — reject uploads larger than this many bytes (default 500 MB).
#INGEST_MAX_PHOTOS_BYTES=500000000
# Ingest blur gate — drop frames whose variance-of-Laplacian sharpness is below
# this (default 60; 0 disables). Applies to both video keyframes and photo sets.
#INGEST_MIN_SHARPNESS=60

# ── "Sign in with Companion Account" (CI-Portal OIDC) ─────────────────────────
# Inert unless enabled. The client id must be registered in CI-Portal's
# PUBLIC_CLIENTS (public PKCE client — no secret). A successful, allowlisted
# sign-in lands on the default world's owner share link. See portal_auth.ts.
#PORTAL_OIDC_ENABLED=1
#OIDC_ISSUER_URL=https://portal.companionintelligence.com
#OIDC_CLIENT_ID=ci-web-xr-scan
# Stable public origin of THIS app (Hub injects it for marketplace installs);
# used to build the OIDC redirect_uri. Falls back to x-forwarded-proto/host.
#APP_BASE_URL=https://scan.example.ts.net
# Allowlist-only trust (CI-Common policy for privileged access). Empty = reject all.
#PORTAL_OIDC_ALLOWED_EMAILS=you@example.com
# Persistent HMAC key for session cookies (default: random per boot).
#SESSION_SECRET=
# Advanced: defaults derived from OIDC_ISSUER_URL / OIDC_CLIENT_ID.
#PORTAL_OIDC_JWKS_URI=
#PORTAL_OIDC_AUDIENCE=ci-web-xr-scan

# ── Companion Memory (CI-Server) push ────────────────────────────────────────
# Where finished scans are filed as spatial memories. On a CI-Hub marketplace
# install these are injected automatically once the user connects Companion
# Memory (hub_integration.memory); set them by hand only for an external,
# self-managed CI-Server. Both must be set or the integration stays inert.
#
# CI_SERVER_URL is the API BASE (note the /api suffix) — the gateway rewrites
# ^/api/(.*) → /$1 and CI-Server sets no global route prefix.
#CI_SERVER_URL=http://gateway:8642/api
# A CI-Server API key (Settings → API Keys), sent as x-api-key. A Portal token
# minted for aud=ci-web-xr-scan is NOT accepted by CI-Server's audience allowlist.
#CI_SERVER_TOKEN=
# Idempotency namespace for ingested events (default: companion-scan).
#MEMORY_PUSH_SOURCE_SYSTEM=companion-scan
# Skip uploading a GLB larger than this many bytes; the event is still recorded.
#MEMORY_PUSH_MAX_UPLOAD_BYTES=536870912
#MEMORY_PUSH_TIMEOUT_MS=120000
